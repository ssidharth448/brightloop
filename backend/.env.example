# Brightloop Backend — Environment Variables
# Copy this file to ../.env and fill in real values

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://brightloop_user:your_password@localhost:5433/brightloop_db

# JWT settings
SECRET_KEY=changeme-generate-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tax rate (percentage)
DEFAULT_TAX_RATE=18.0

# Docker PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=brightloop_db
POSTGRES_USER=brightloop_user
POSTGRES_PASSWORD=your_password

# Docker MySQL (used by docker-compose.yml)
MYSQL_DATABASE=brightloop_db
MYSQL_USER=brightloop_user
MYSQL_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=your_root_password
